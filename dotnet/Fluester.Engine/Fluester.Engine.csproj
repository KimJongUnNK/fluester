<Project Sdk="Microsoft.NET.Sdk">
  <!-- Gemeinsame Dienste für Windows und Linux: Erkennung (Whisper lokal, Cloud), Bereinigung, Speicher, Modelle. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Fluester.Engine</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Fluester.Core/Fluester.Core.csproj" />
  </ItemGroup>
</Project>
